{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aulo",
  "version": "0.1.0",
  "identifier": "studio.aulo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aulo",
        "width": 1440,
        "height": 940,
        "minWidth": 960,
        "minHeight": 700,
        "backgroundColor": "#131413"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Your music, your space.",
    "category": "Music",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
